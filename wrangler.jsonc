{
  // Cloudflare Worker + Static Assets config.
  //
  // IMPORTANT: `name` must match the Worker created in the Cloudflare dashboard.
  // If your Worker has a different name (see the title of the project page),
  // change this one value to match it.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onboarding-design",
  "main": "worker/index.ts",
  "compatibility_date": "2024-11-01",
  "assets": {
    // The Vite build output. `npm run build` runs before the deploy command.
    "directory": "./dist",
    "binding": "ASSETS",
    // Serve index.html for unknown paths so client-side routing works.
    "not_found_handling": "single-page-application"
  },
  // Login credentials store (per-person accounts + signup requests). Create a
  // KV namespace (Workers & Pages → KV → Create) and paste its id below, or
  // run `wrangler kv namespace create AUTH_KV` — see DEPLOYMENT.md § Login.
  "kv_namespaces": [
    {
      "binding": "AUTH_KV",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ]
}

{
  // Cloudflare Worker + Static Assets config.
  //
  // IMPORTANT: `name` must match the Worker created in the Cloudflare dashboard.
  // If your Worker has a different name (see the title of the project page),
  // change this one value to match it.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onboarding-design",
  "main": "worker/index.ts",
  "compatibility_date": "2024-11-01",
  "assets": {
    // The Vite build output. `npm run build` runs before the deploy command.
    "directory": "./dist",
    "binding": "ASSETS",
    // Serve index.html for unknown paths so client-side routing works.
    "not_found_handling": "single-page-application"
  }

  // ── Private video storage (R2) ─────────────────────────────────────────────
  // Confidential videos are streamed through the Worker from a PRIVATE R2
  // bucket (never a public r2.dev URL). To enable:
  //   1. Create an R2 bucket named "biomar-onboarding-media" (keep it private).
  //   2. Uncomment the binding below and redeploy.
  //   3. Upload videos to the bucket; reference them by key in src/content/materials.ts.
  // Until this is enabled, /media/video/* returns a friendly 501 and nothing breaks.
  //
  // "r2_buckets": [
  //   { "binding": "MEDIA", "bucket_name": "biomar-onboarding-media" }
  // ]
}
